# 被测 Agent 使用 OpenAI Chat Completions 兼容协议时填写
AGENT_EVAL_BASE_URL=https://your-agent.example.com/v1
AGENT_EVAL_API_KEY=
AGENT_EVAL_MODEL=your-model

# 评测 Agent 自身使用 pi-mono；不设置时自动使用 Faux Provider 演示完整工具循环。
PI_PROVIDER=openai
PI_MODEL=your-evaluator-model
PI_BASE_URL=https://your-evaluator-api.example.com/v1
# 可填写 PI_API_KEY；使用 openai Provider 时也可改用 OPENAI_API_KEY。
PI_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Playwright 浏览器执行器（复用本机已下载的 Chromium）
# 通常无需填写，系统会自动查找 Chrome、Edge 或 Chromium；仅在自动查找失败时设置绝对路径。
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_CHANNEL=chrome
PLAYWRIGHT_PROFILE_DIR=./data/playwright-profile
PLAYWRIGHT_SCREENSHOT_DIR=./data/screenshots
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_DEBUG_PORT=9333
AGENT_EVAL_ARTIFACT_DIR=./artifacts

# 被测 Agent 日志所在的 Langfuse 项目；密钥仅保存在本地。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端 / 自部署 v4 使用 v2；自部署 v3 改成 v1。
LANGFUSE_API_VERSION=v2
