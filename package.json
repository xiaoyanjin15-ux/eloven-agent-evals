{
  "name": "agent-evals-pi-harness",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "description": "pi-mono runtime bridge for the Agent evaluation workbench",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/src/*.test.js dist/pi-agent/src/*.test.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/src/server.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.79.10",
    "@earendil-works/pi-ai": "0.79.10",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "playwright-core": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "archiver": "7.0.1",
      "unzipper": "0.12.5"
    }
  }
}
